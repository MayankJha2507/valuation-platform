# Backend environment variables — TEMPLATE
#
# How to use this file:
#   1. Copy it: `cp .env.example .env`
#   2. Fill in real values in `.env` (which is gitignored)
#   3. NEVER commit `.env`. NEVER paste these values into chat or screenshots.
#
# All values come from Supabase: Project Settings → API.

# Public project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# anon (public) key — JWT starting with eyJ...
# Safe-ish: respects Row Level Security. Used by frontend later.
SUPABASE_ANON_KEY=your-anon-key-here

# service_role key — JWT starting with eyJ...
# TOP SECRET. Bypasses all security. Backend-only. Never in frontend, never in git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
